---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume">
  <p style="font-size: 0.9rem;">
    <a href="/resume.pdf">Open full size / download &rarr;</a>
  </p>

  <object data="/resume.pdf#toolbar=0&view=FitH" type="application/pdf" class="resume-embed">
    <p class="measure muted">
      Your browser can't display the embedded PDF &mdash;
      <a href="/resume.pdf">download it instead</a>.
    </p>
  </object>
</Layout>

<style>
  .resume-embed {
    width: 100%;
    aspect-ratio: 8.5 / 11;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
</style>
