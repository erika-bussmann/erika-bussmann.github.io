---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('creative', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Creative">
  <h1>Creative</h1>
  <p class="measure muted" style="font-size: 0.85rem;">All work is human-generated. Content is intended for creative purposes only.</p>
  {posts.length === 0 ? (
    <p class="measure muted">Nothing published yet &mdash; writing and other creative/multimedia work will land here.</p>
  ) : (
    <ul class="plain measure">
      {posts.map((post) => (
        <li style="margin-bottom: 1.5rem;">
          <a href={`/creative/${post.slug}`}><strong>{post.data.title}</strong></a>
          <p style="margin-top: 0.3rem;">{post.data.dek}</p>
        </li>
      ))}
    </ul>
  )}
</Layout>
