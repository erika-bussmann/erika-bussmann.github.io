---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: '"Capital" For Tech Workers',
    period: '2025–present',
    blurb:
      'A course, co-designed and co-taught, helping tech workers critically examine the ethics and political economy of the tech industry, with AI as a central case study. Paired with a textbook co-authored in partnership with researchers at the Free Computing Lab.',
    link: null,
  },
  {
    title: 'Google AI Principles Pioneers',
    period: '2023–2025',
    blurb:
      'Trained contributor to adversarial testing of new product launches, evaluating fairness, safety, and human-rights-related risk vectors against Google’s AI Principles.',
    link: null,
  },
  {
    title: 'Responsible Computing, Brown University',
    period: '2020–2022',
    blurb:
      'Designed and taught curriculum on the sociopolitical, economic, and environmental consequences of deep learning-powered products (Deep Learning course), and co-created an independent survey study on tech futures, automation, and AGI (Technofutures & Dystopias).',
    link: null,
  },
];
---

<Layout title="Projects">
  <h1>Projects</h1>
  <p class="measure muted">A selection of work outside the day-to-day &mdash; teaching, advising, and earlier explorations.</p>

  <ul class="plain measure">
    {projects.map((p) => (
      <li style="margin-bottom: 2rem;">
        <h2 style="margin-top: 0;">{p.title} <span class="muted" style="font-family: var(--font-sans); font-size: 0.85rem;">{p.period}</span></h2>
        <p>{p.blurb}</p>
        {p.link && <a href={p.link}>Learn more &rarr;</a>}
      </li>
    ))}
  </ul>
</Layout>
