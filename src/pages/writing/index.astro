---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Writing">
  <h1>Writing</h1>
  {posts.length === 0 ? (
    <p class="measure muted">Nothing published yet &mdash; sociotechnical essays will land here.</p>
  ) : (
    <ul class="plain measure">
      {posts.map((post) => (
        <li style="margin-bottom: 1.5rem;">
          <a href={`/writing/${post.slug}`}><strong>{post.data.title}</strong></a>
          <div class="muted" style="font-size: 0.9rem;">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </div>
          <p style="margin-top: 0.3rem;">{post.data.dek}</p>
        </li>
      ))}
    </ul>
  )}
</Layout>
