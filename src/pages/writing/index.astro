---
import Layout from '../../layouts/Layout.astro';

const elsewhere = [
  {
    title: 'Novel Hand',
    period: '2020–2021',
    url: 'https://novelhand.com/author/erikab/',
    note: 'Essays on activism, technology, and social impact — hacktivism, effective altruism, corporate accountability, and more.',
  },
  {
    title: '"Keepin\' It Brief"',
    period: '2019',
    url: 'https://brownpoliticalreview.org/author/ebussmann/',
    note: 'Written as Data Director, Brown Political Review — on the White House press briefing as a communication channel.',
  },
];
---

<Layout title="Writing">
  <h1>Writing</h1>
  <p class="measure muted">Nothing published on this site yet &mdash; in the meantime, a few pieces from elsewhere.</p>

  <ul class="plain measure">
    {elsewhere.map((p) => (
      <li style="margin-bottom: 1.75rem;">
        <div><strong><a href={p.url}>{p.title}</a></strong> <span class="muted" style="font-family: var(--font-sans); font-size: 0.85rem;">{p.period}</span></div>
        <p style="margin-top: 0.3rem;">{p.note}</p>
      </li>
    ))}
  </ul>
</Layout>
